    # ---------- dialog
    def dialog(self, title, text, buttons):
        top = tk.Toplevel(self.root)
        top.title(title)
        top.configure(bg=CARD)
        top.transient(self.root)
        top.resizable(False, False)
        tk.Label(top, text=title, bg=CARD, fg=FG, font=(FONT, 11, "bold")).pack(
            anchor="w", padx=16, pady=(14, 4))
        tk.Label(top, text=text, bg=CARD, fg=MUT, font=(FONT, BODY),
                 justify="left", wraplength=460).pack(anchor="w", padx=16, pady=(0, 12))
        row = tk.Frame(top, bg=CARD)
        row.pack(fill="x", padx=16, pady=(0, 14))
        result = {"v": None}

        def close(v):
            result["v"] = v
            top.destroy()

        for label, val in buttons:
            self.button(row, label, lambda v=val: close(v)).pack(side="right", padx=(6, 0))
        top.update_idletasks()
        x = self.root.winfo_rootx() + (self.root.winfo_width() - top.winfo_width()) // 2
        y = self.root.winfo_rooty() + (self.root.winfo_height() - top.winfo_height()) // 2
        top.geometry("+%d+%d" % (max(x, 0), max(y, 0)))
        top.grab_set()
        top.wait_window()
        return result["v"]

    def ask(self, text):
        return self.dialog("Konfirmasi", text,
                           [("Ya", True), ("Batal", False)]) is True

    def info(self, text):
        self.dialog("Informasi", text, [("Tutup", True)])


def acquire_single_instance():
    """Cegah dua jendela. Kalau sudah jalan, naikkan jendela yang ada."""
    import fcntl
    path = os.path.join(HOME, ".cache", "diknom-network.lock")
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        fh = open(path, "w")
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        for cmd in (["xdotool", "search", "--name", "^DikNom System Network$",
                     "windowactivate"],
                    ["wmctrl", "-a", APP]):
            try:
                subprocess.run(cmd, timeout=5)
                break
            except Exception:  # noqa: BLE001
                continue
        return None
    fh.write(str(os.getpid()))
    fh.flush()
    return fh


def main():
    global FONT, MONO
    lock = acquire_single_instance()
    if lock is None:
        return
    root = tk.Tk()
    try:
        fams = set(tkfont.families(root))
        FONT = "Noto Sans" if "Noto Sans" in fams else "DejaVu Sans"
        MONO = "Noto Sans Mono" if "Noto Sans Mono" in fams else "DejaVu Sans Mono"
    except Exception:  # noqa: BLE001
        pass
    app = App(root)
    root.protocol("WM_DELETE_WINDOW", app.close)
    root.lift()
    root.attributes("-topmost", True)
    root.after(500, lambda: root.attributes("-topmost", False))
    root.focus_force()
    root.mainloop()


if __name__ == "__main__":
    main()
