    # ---------- data
    def drain(self):
        try:
            while True:
                fn = self.q.get_nowait()
                fn()
        except queue.Empty:
            pass
        self.root.after(150, self.drain)

    def bg(self, fn, done=None):
        def run():
            try:
                res = fn()
            except Exception as exc:  # noqa: BLE001
                res = str(exc)
            self.q.put(self.refresh)
            if done:
                self.q.put(lambda: done(res))
        threading.Thread(target=run, daemon=True).start()

    def say(self, text, color=MUT):
        self.status.configure(text=text, fg=color)

    def refresh(self):
        def work():
            st = collect()
            now = time.monotonic()
            dt = max(now - self.prev_t, 0.001)
            rates = {}
            for d in st["devices"]:
                cur = (d["rx"], d["tx"])
                old = self.prev.get(d["dev"])
                if old:
                    rates[d["dev"]] = ((cur[0] - old[0]) / dt,
                                       (cur[1] - old[1]) / dt)
                self.prev[d["dev"]] = cur
            self.prev_t = now
            self.q.put(lambda: self.apply(st, rates))
        threading.Thread(target=work, daemon=True).start()

    def apply(self, st, rates):
        if rates:
            self.rates = rates
        self.last_state = st
        page = self.pages.get(self.current)
        if page is not None:
            try:
                page.apply(st)
            except Exception:  # noqa: BLE001
                traceback.print_exc()
        devs = st["devices"]
        wifi = next((d for d in devs if d["type"] == "wifi"), None)
        eth = next((d for d in devs if d["type"] == "ethernet"
                    and d["state"].startswith("connected")), None)
        online = st["default_gw"] != "—"
        if online:
            self.pill.configure(text=tr("ONLINE"), bg="#12351f", fg=GREEN)
        else:
            self.pill.configure(text=tr("TANPA INTERNET"), bg="#3a1b1e",
                                fg=RED)
        try:
            self.side_dot.itemconfigure(1, fill=GREEN if online else RED)
        except Exception:
            pass
        parts = []
        if wifi and wifi["state"].startswith("connected"):
            parts.append(wifi["dev"])
        if eth:
            parts.append(eth["dev"])
        self.side_iface.configure(
            text=tr("aktif:") + " " + (", ".join(parts) or "—"))
        self.side_ip.configure(
            text=st["default_gw"] if online else "")

        if self.current == "wifi":
            now = time.monotonic()
            if now - self.last_log > 5:
                self.last_log = now
                self.bg(lambda: recent_log(), lambda lg: self.set_log(lg))
            if now - getattr(self, "last_portal", 0) > 20:
                self.last_portal = now
                self.check_portal()


    def set_log(self, text):
        w = self.pages["wifi"].log
        if not text:
            return
        w.configure(state="normal")
        w.delete("1.0", "end")
        w.insert("end", text)
        w.configure(state="disabled")
        w.see("end")

    def apply_last(self):
        st = getattr(self, "last_state", None)
        if st:
            try:
                self.pages[self.current].apply(st)
            except Exception:  # noqa: BLE001
                traceback.print_exc()

    def tick(self):
        self.refresh()
        self.hotspot_tick()
        self.root.after(3000, self.tick)

    # ---------- aksi
    def wd(self, what):
        if what == "enable":
            cmd, msg = "systemctl enable --now wifi-watchdog.timer", "Watchdog diaktifkan"
        elif what == "disable":
            cmd, msg = "systemctl disable --now wifi-watchdog.timer", "Watchdog dimatikan"
        else:
            cmd, msg = "systemctl start wifi-watchdog.service", "Watchdog dijalankan sekali"
        self.say("menunggu izin…")
        self.bg(lambda: pkexec(cmd, timeout=60),
                lambda r: self.say("%s — %s" % (msg, "ok" if r[1] == 0 else r[0][:120]),
                                   GREEN if r[1] == 0 else RED))

    def ps(self, value):
        conf = "[connection]\nwifi.powersave = %s\n" % value
        try:
            with open(TMPCONF, "w", encoding="utf-8") as fh:
                fh.write(conf)
            os.chmod(TMPCONF, 0o600)
        except OSError as exc:
            self.say("gagal menulis setelan: %s" % exc, RED)
            return
        conns = [n for n, _ in conn_powersave()]
        mod = "; ".join("nmcli con modify '%s' 802-11-wireless.powersave %s" %
                        (n.replace("'", "'\\''"), value) for n in conns)
        cmd = ("install -m 0644 %s %s && systemctl reload NetworkManager"
               % (TMPCONF, ZCONF)) + (("; " + mod) if mod else "")
        self.say("menerapkan powersave…")
        self.bg(lambda: pkexec(cmd, timeout=90),
                lambda r: self.say("Powersave %s — %s" %
                                   ("nonaktif" if value == "2" else "aktif",
                                    "ok" if r[1] == 0 else r[0][:140]),
                                   GREEN if r[1] == 0 else RED))

    def reset(self):
        if os.path.exists(WIFI_RESET):
            if not self.ask("Reset WiFi sekarang?\n\nDriver in-kernel dilepas, "
                            "PCI di-reset, lalu driver dimuat lagi. Koneksi "
                            "putus sekitar 20 detik."):
                return
            self.say("mereset WiFi… (minta izin)")
            self.bg(lambda: sh([WIFI_RESET], timeout=180),
                    lambda r: self.say("Reset selesai — %s" %
                                       ("ok" if r[1] == 0 else r[0][-140:]),
                                       GREEN if r[1] == 0 else RED))
            return
        if shutil.which("nmcli"):
            if not self.ask("wifi-reset khusus Ubuntu tidak ada.\n\n"
                            "Gunakan reset NetworkManager (Wi-Fi putus sebentar)?"):
                return
            self.say("mereset NetworkManager… (minta izin)")
            self.bg(lambda: pkexec("nmcli networking off; sleep 2; "
                                    "nmcli networking on", timeout=90),
                    lambda r: self.say("Reset NetworkManager — %s" %
                                       ("ok" if r[1] == 0 else r[0][-140:]),
                                       GREEN if r[1] == 0 else RED))
            return
        self.say("Reset tidak tersedia: wifi-reset/nmcli tidak ditemukan", RED)

    def check(self):
        self.say("memeriksa…")
        if os.path.exists(WIFI_RESET):
            self.bg(lambda: sh([WIFI_RESET, "--check"], timeout=30),
                    lambda r: self.info("Cek cepat\n\n" + r[0]))
            return
        self.bg(lambda: sh(["nmcli", "device", "status"], timeout=20)
                if shutil.which("nmcli") else sh(["ip", "-brief", "link"]),
                lambda r: self.info("Cek cepat\n\n" + r[0]))

    def scan(self):
