    def apply(self, st):
        for wdg in self.rows.winfo_children():
            wdg.destroy()
        heads = ((tr("Perangkat"), 17), (tr("Jenis"), 10),
                 (tr("Status"), 18), (tr("Profil"), 22),
                 (tr("IP / subnet"), 20), (tr("Gateway"), 15),
                 ("MTU", 5))
        hrow = tk.Frame(self.rows, bg=CARD)
        hrow.pack(fill="x", pady=(0, 4))
        for text, w in heads:
            tk.Label(hrow, text=text, bg=CARD, fg=DIM, font=(FONT, TINY),
                     width=w, anchor="w").pack(side="left")

        for d in st["devices"]:
            row = tk.Frame(self.rows, bg=CARD)
            row.pack(fill="x", pady=1)
            on = d["state"].startswith("connected")
            raw = (d["dev"], tr(d["type"]), tr(d["state"].split()[0]),
                   d["conn"] or "—", d["ip4"], d["gw"] or "—", d["mtu"])
            vals = [clip(v, w - 1) for v, (_, w) in zip(raw, heads)]
            for i, (val, (_, w)) in enumerate(zip(vals, heads)):
                color = FG
                if i == 2:
                    color = GREEN if on else MUT
                elif i == 4:
                    color = BLUE
                tk.Label(row, text=val, bg=CARD, fg=color,
                         font=(MONO if i in (0, 4, 5, 6) else FONT, TINY),
                         width=w, anchor="w").pack(side="left")

        dns_only = "\n".join(
            "%s  %s" % (clip(d["dev"], 18), clip(", ".join(d["dns"][:2]), 34))
            for d in st["devices"] if d["dns"]) or "—"
        self.dns_lbl.configure(text="DNS\n" + dns_only)
        self.mac_lbl.configure(
            text="MAC\n" + "\n".join(
                "%s  %s" % (clip(d["dev"], 18), d["mac"])
                for d in st["devices"]))
        self.route_lbl.configure(
            text="\n".join(st["routes"]) or tr("tanpa rute default"))

        ports_seen, ports_lines = set(), []
        for addr, _proto in st["ports"]:
            addr = re.sub(r"%[^:]+", "", addr)
            if addr in ports_seen:
                continue
            ports_seen.add(addr)
            ports_lines.append("  " + addr)
        self.port_lbl.configure(text="\n".join(ports_lines) or "—")


