def clip(text, width):
    text = "" if text is None else str(text)
    if len(text) <= width:
        return text
    return text[:max(1, width - 1)] + "…"


def human_bytes_short(n):
    try:
        n = float(n)
    except (TypeError, ValueError):
        return "—"
    if n < 1024:
        return "%d B" % n
    for unit in ("K", "M", "G"):
        n /= 1024.0
        if n < 1024 or unit == "G":
            return "%.1f%s" % (n, unit)
    return "%.1fG" % n


def human_bytes(n):
    try:
        n = float(n)
    except (TypeError, ValueError):
        return "—"
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return "%.1f %s" % (n, unit) if unit != "B" else "%d B" % n
        n /= 1024


def split_nmcli(line):
    """Pecah output nmcli -t pada titik dua yang TIDAK di-escape."""
    parts, cur, esc = [], [], False
    for ch in line:
        if esc:
            cur.append(ch)
            esc = False
        elif ch == "\\":
            esc = True
        elif ch == ":":
            parts.append("".join(cur))
            cur = []
        else:
            cur.append(ch)
    parts.append("".join(cur))
    return parts


def read_text(path, default="—"):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            return fh.read().strip()
    except OSError:
        return default


def os_release_info():
    data = {}
    try:
        with open("/etc/os-release", "r", encoding="utf-8",
                  errors="replace") as fh:
            for line in fh:
                if "=" not in line:
                    continue
                k, v = line.rstrip("\n").split("=", 1)
                data[k] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return {
        "id": data.get("ID", "linux"),
        "name": data.get("NAME", "Linux"),
        "version": data.get("VERSION_ID", ""),
        "pretty": data.get("PRETTY_NAME") or data.get("NAME") or "Linux",
    }


