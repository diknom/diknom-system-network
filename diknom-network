def sysfs_devices():
    rows = []
    root = "/sys/class/net"
    try:
        names = sorted(os.listdir(root))
    except OSError:
        return rows
    for name in names:
        if name == "lo":
            continue
        base = os.path.join(root, name)
        wifi = os.path.isdir(os.path.join(base, "wireless"))
        typ = "wifi" if wifi else "ethernet"
        carrier = read_text(os.path.join(base, "carrier"), "0")
        oper = read_text(os.path.join(base, "operstate"), "down")
        connected = carrier == "1" and oper == "up"
        rows.append({
            "dev": name, "type": typ,
            "state": "connected" if connected else "disconnected",
            "conn": "",
        })
    return rows


def wifi_driver(iface=None):
    iface = iface or wifi_iface()
    if not iface:
        return "—"
    path = "/sys/class/net/%s/device/driver" % iface
    if os.path.exists(path):
        return os.path.basename(os.path.realpath(path))
    out, _ = sh(["ethtool", "-i", iface], timeout=4)
    m = re.search(r"^driver:\s*(\S+)", out, re.M)
    return m.group(1) if m else "—"


def wifi_chip(iface=None):
    iface = iface or wifi_iface()
    out, _ = sh(["lspci", "-nn"], timeout=5)
    lines = out.splitlines()
    for line in lines:
        low = line.lower()
        if "network controller" in low or "wireless" in low:
            return line.split(": ", 1)[-1][:90]
    for line in lines:
        if "ethernet controller" in line.lower():
            return line.split(": ", 1)[-1][:90]
    if iface:
        uevent = read_text("/sys/class/net/%s/device/uevent" % iface)
        for line in uevent.splitlines():
            if line.startswith(("PCI_ID=", "PRODUCT=")):
                return line.split("=", 1)[1]
    return "—"


def ap_support():
    if not shutil.which("iw"):
        return "?"
    out, _ = sh(["iw", "list"], timeout=8)
    return "AP" if "* AP" in out else "—"


def hardware_info():
    now = time.time()
    cached = globals().get("_HW_CACHE")
    if cached and now - cached.get("_ts", 0) < 60:
        return cached
    iface = wifi_iface()
    data = {
        "_ts": now,
        "wifi_driver": wifi_driver(iface),
        "wifi_chip": wifi_chip(iface),
        "ap": ap_support(),
    }
    globals()["_HW_CACHE"] = data
    return data


def dev_list():
    out, _ = sh(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device", "status"])
    rows = []
    for line in out.splitlines():
        parts = split_nmcli(line)
        if len(parts) < 4:
            continue
        dev, typ, state, conn = parts[0], parts[1], parts[2], ":".join(parts[3:])
        if typ in ("loopback",):
            continue
        rows.append({"dev": dev, "type": typ, "state": state, "conn": conn})
    return rows or sysfs_devices()


def dev_detail(dev):
    info = {"ip4": "—", "ip6": "—", "mac": "—", "mtu": "—", "speed": "", "dns": [], "gw": ""}
    out, _ = sh(["ip", "-o", "addr", "show", dev])
    v4 = re.search(r"inet (\d+\.\d+\.\d+\.\d+/\d+)", out)
    v6 = re.search(r"inet6 ([0-9a-f:]+/\d+)", out)
    if v4:
        info["ip4"] = v4.group(1)
    if v6:
        info["ip6"] = v6.group(1)
    mac, rc = sh(["cat", "/sys/class/net/%s/address" % dev])
    mtu, rc2 = sh(["cat", "/sys/class/net/%s/mtu" % dev])
    if rc == 0 and mac:
        info["mac"] = mac
    if rc2 == 0 and mtu:
        info["mtu"] = mtu
    sp, rc = sh(["cat", "/sys/class/net/%s/speed" % dev])
    if rc == 0 and sp.isdigit() and int(sp) > 0:
        info["speed"] = "%s Mb/s" % sp
    route, _ = sh(["ip", "route", "show", "dev", dev])
    m = re.search(r"default via (\S+)", route)
    if m:
        info["gw"] = m.group(1)
    dns, _ = sh(["nmcli", "-t", "-f", "IP4.DNS", "device", "show", dev])
    for line in dns.splitlines():
        if ":" in line:
            val = line.split(":", 1)[1].strip()
            if val and val not in info["dns"]:
                info["dns"].append(val)
    if not info["dns"]:
        resolved, _ = sh(["resolvectl", "dns", dev], timeout=4)
        for line in resolved.splitlines():
            for val in re.findall(r"\b(?:\d{1,3}\.){3}\d{1,3}\b", line):
                if val not in info["dns"]:
                    info["dns"].append(val)
    if not info["dns"]:
        for line in read_text("/etc/resolv.conf").splitlines():
            if line.startswith("nameserver"):
                val = line.split()[1]
                if val not in info["dns"]:
                    info["dns"].append(val)
    return info


def counters(dev):
    try:
        with open("/sys/class/net/%s/statistics/rx_bytes" % dev) as fh:
            rx = int(fh.read())
        with open("/sys/class/net/%s/statistics/tx_bytes" % dev) as fh:
            tx = int(fh.read())
        return rx, tx
    except OSError:
        return 0, 0


def wifi_iface():
    for row in dev_list():
        if row["type"] == "wifi":
            return row["dev"]
    for row in sysfs_devices():
        if row["type"] == "wifi":
            return row["dev"]
    return ""


def iw_link(iface):
    info = {"ssid": "—", "freq": "—", "signal": "—", "rate": "—", "bssid": "—", "band": ""}
    if not iface:
        return info
    out, _ = sh(["iw", "dev", iface, "link"], timeout=6)
    if "Not connected" in out:
        return info
    m = re.search(r"Connected to ([0-9a-f:]+)", out)
    if m:
        info["bssid"] = m.group(1)
    m = re.search(r"SSID:\s*(.+)", out)
    if m:
        info["ssid"] = m.group(1).strip()
    m = re.search(r"freq:\s*([0-9.]+)", out)
    if m:
        f = float(m.group(1))
        info["freq"] = "%s MHz" % m.group(1)
        info["band"] = "5 GHz" if f > 4000 else "2.4 GHz"
    m = re.search(r"signal:\s*(-?[0-9]+ dBm)", out)
    if m:
        info["signal"] = m.group(1)
    m = re.search(r"tx bitrate:\s*([0-9.]+ [GMK]?Bit/s)", out)
    if m:
        info["rate"] = m.group(1)
    if info["ssid"] == "—":
        nm, _ = sh(["nmcli", "-t", "-f", "ACTIVE,SSID,SIGNAL", "device", "wifi", "list"])
        for line in nm.splitlines():
            parts = split_nmcli(line)
            if len(parts) >= 3 and parts[0] == "yes":
                info["ssid"] = parts[1]
                info["signal"] = parts[2] + "%"
                break
    return info


def powersave_global():
    try:
        with open(ZCONF, "r", encoding="utf-8") as fh:
            m = re.search(r"wifi\.powersave\s*=\s*([0-9])", fh.read())
    except OSError:
        return "bawaan sistem"
    if not m:
        return "bawaan sistem"
    return {"0": "bawaan", "1": "aktif", "2": "nonaktif", "3": "aktif"}.get(m.group(1), m.group(1))


def conn_powersave():
    out, _ = sh(["nmcli", "-t", "-f", "NAME,TYPE", "con", "show"])
    rows = []
    for line in out.splitlines():
        parts = split_nmcli(line)
        if len(parts) < 2 or parts[1] != "802-11-wireless":
            continue
        name = parts[0]
        val, _ = sh(["nmcli", "-t", "-f", "802-11-wireless.powersave", "con", "show", name])
        rows.append((name, val.split(":")[-1].strip() if ":" in val else "bawaan"))
    return rows


def watchdog_state():
    if not shutil.which("systemctl"):
        return {"enabled": "—", "active": "—", "last": "—", "next": "—"}
    en, _ = sh(["systemctl", "is-enabled", "wifi-watchdog.timer"])
    ac, _ = sh(["systemctl", "is-active", "wifi-watchdog.timer"])
    last, _ = sh(["systemctl", "show", "-p", "LastTriggerUSec", "--value", "wifi-watchdog.timer"])
    nxt, _ = sh(["systemctl", "show", "-p", "NextElapseUSecMonotonic", "--value", "wifi-watchdog.timer"])
    return {"enabled": en.strip() or "?", "active": ac.strip() or "?",
            "last": last.strip() or "—", "next": nxt.strip() or "—"}


def modprobe_params():
    opts = {}
    driver = wifi_driver()
    modules = ["rtw88_core", "rtw88_pci"]
    if driver not in ("—", "", "?"):
        modules.insert(0, driver)
    for param in ("disable_lps_deep", "disable_aspm"):
        value = "?"
        for module in modules:
            path = "/sys/module/%s/parameters/%s" % (module, param)
            try:
                with open(path) as fh:
                    value = fh.read().strip()
                break
            except OSError:
                continue
        opts[param] = value
    return opts


def flood_stats(minutes=5):
    out, _ = sh(["journalctl", "-k", "--since", "-%d min" % minutes, "--no-pager"], timeout=15)
    return out.count("pci bus timeout"), out.count("failed to send h2c")


def recent_log(lines=40):
    out, _ = sh(["journalctl", "-k", "-n", "400", "--no-pager", "-o", "short-iso"], timeout=15)
    iface = wifi_iface()
    driver = wifi_driver(iface)
    keys = [k for k in (iface, driver, "wifi-watchdog", "firmware") if k]
    keep = [ln for ln in out.splitlines()
            if any(k in ln for k in keys) or "wifi" in ln.lower()]
    return "\n".join(keep[-lines:])


def host_info():
    def first(cmd):
        out, _ = sh(cmd)
        return out.splitlines()[0].strip() if out else "—"
    up = ""
    try:
        with open("/proc/uptime") as fh:
            secs = int(float(fh.read().split()[0]))
        d, rem = divmod(secs, 86400)
        h, rem = divmod(rem, 3600)
        m = rem // 60
        up = ("%d hari " % d if d else "") + "%d jam %d mnt" % (h, m)
    except OSError:
        up = "—"
    rel = os_release_info()
    hw = hardware_info()
    hostname, host_rc = sh(["hostname"])
    hostname = hostname.splitlines()[0].strip() if hostname else ""
    if host_rc != 0 or not hostname:
        hostname = read_text("/proc/sys/kernel/hostname")
    return {
        "host": hostname or "—",
        "kernel": os.uname().release,
        "distro": rel["pretty"],
        "distro_id": rel["id"],
        "pkg": package_manager(),
        "desktop": os.environ.get("XDG_CURRENT_DESKTOP")
        or os.environ.get("DESKTOP_SESSION")
        or "—",
        "uptime": up,
        "wifi_driver": hw["wifi_driver"],
        "wifi_chip": hw["wifi_chip"],
        "ap": hw["ap"],
    }


def collect():
    devs = dev_list()
    for row in devs:
        row.update(dev_detail(row["dev"]))
        row["rx"], row["tx"] = counters(row["dev"])
    iface = next((r["dev"] for r in devs if r["type"] == "wifi"), "")
    route, _ = sh(["ip", "route", "show", "default"])
    default_dev, default_gw = "", ""
    m = re.search(r"default via (\S+) dev (\S+)", route)
    if m:
        default_gw, default_dev = m.group(1), m.group(2)
    ports, _ = sh(["ss", "-ltnH"])
    port_rows = []
    for line in ports.splitlines():
        p = line.split()
        if len(p) >= 4:
            port_rows.append((p[3], p[0]))
    pci = ""
    if iface:
        dp = os.path.realpath("/sys/class/net/%s/device" % iface)
        if dp.startswith("/sys/devices"):
            pci = os.path.basename(dp)
    radio_status, _ = sh(["nmcli", "-t", "-f", "WIFI", "general", "status"])
    return {
        "devices": devs,
        "radio": radio_status.strip() or "?",
        "iface": iface,
        "pci": pci,
        "wifi": iw_link(iface),
        "default_dev": default_dev or "—",
        "default_gw": default_gw or "—",
        "routes": [ln for ln in route.splitlines() if ln.startswith("default")],
        "ps_global": powersave_global(),
        "ps_conn": conn_powersave(),
        "wd": watchdog_state(),
        "params": modprobe_params(),
        "flood": flood_stats(),
        "ports": port_rows[:12],
        "host": host_info(),
    }


class HotspotClient:
    """Klien helper root hotspot (pkexec + JSON per baris)."""

    def __init__(self):
        self.proc = None
        self.q = queue.Queue()
        self.lock = threading.Lock()
        self.stderr = []

    @property
    def alive(self):
        return self.proc is not None and self.proc.poll() is None

    def start(self):
        if self.alive:
            return
        if not os.path.exists(HOTSPOT_HELPER):
            raise RuntimeError("Helper hotspot belum dipasang")
        if not os.access(HOTSPOT_HELPER, os.X_OK):
            raise RuntimeError("Helper hotspot tidak executable")
        self.proc = subprocess.Popen(
            ["pkexec", HOTSPOT_HELPER],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, text=True, bufsize=1)
        threading.Thread(target=self._read_stdout,
                         args=(self.proc.stdout,), daemon=True).start()
        threading.Thread(target=self._read_stderr,
                         args=(self.proc.stderr,), daemon=True).start()

    def _read_stdout(self, stream):
        try:
            for line in stream:
                line = line.strip()
                if not line:
                    continue
                try:
                    msg = json.loads(line)
                except Exception:
                    msg = {"ok": False, "error": line}
                if isinstance(msg, dict):
                    msg["_event"] = "message"
                    self.q.put(msg)
        finally:
            self.q.put({"event": "exit",
                        "code": self.proc.poll() if self.proc else None})

    def _read_stderr(self, stream):
        for line in stream:
            line = line.strip()
            if not line:
                continue
            self.stderr.append(line)
            if len(self.stderr) > 30:
                self.stderr.pop(0)

    def send(self, **cmd):
        self.start()
        with self.lock:
            if not self.proc or self.proc.poll() is not None:
                raise RuntimeError("Helper hotspot tidak berjalan")
            self.proc.stdin.write(json.dumps(cmd, ensure_ascii=False) + "\n")
            self.proc.stdin.flush()

    def close(self):
        if not self.alive:
            return
        try:
            with self.lock:
                self.proc.stdin.write('{"cmd":"quit"}\n')
                self.proc.stdin.flush()
            self.proc.wait(timeout=2)
        except Exception:
            try:
                self.proc.terminate()
            except Exception:
                pass


