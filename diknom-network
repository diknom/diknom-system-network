class Card(tk.Frame):
    def __init__(self, master, title, subtitle="", accent=None):
        super().__init__(master, bg=CARD, highlightbackground=BORDER,
                         highlightthickness=1, bd=0)
        head = tk.Frame(self, bg=CARD)
        head.pack(fill="x", padx=16, pady=(14, 0))
        if accent:
            bar = tk.Frame(head, bg=accent, width=3, height=15)
            bar.pack(side="left", padx=(0, 9), pady=1)
            bar.pack_propagate(False)
        tk.Label(head, text=title, bg=CARD, fg=FG,
                 font=(FONT, 11, "bold"), anchor="w").pack(side="left")
        self.sub_lbl = None
        if subtitle:
            self.sub_lbl = tk.Label(head, text=subtitle, bg=CARD, fg=MUT,
                                    font=(FONT, TINY), anchor="e")
            self.sub_lbl.pack(side="right")
        self.body = tk.Frame(self, bg=CARD)
        self.body.pack(fill="both", expand=True, padx=16, pady=(10, 14))

    def row(self, label, value="—", key=None, width=16, mono=False,
            color=FG):
        f = tk.Frame(self.body, bg=CARD)
        f.pack(fill="x", pady=1)
        tk.Label(f, text=label, bg=CARD, fg=MUT,
                 font=(FONT, SMALL), width=width, anchor="w").pack(side="left")
