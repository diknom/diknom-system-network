    # ---------- hotspot
    def hotspot_page(self):
        return self.pages.get("hotspot")

    def hotspot_update(self):
        page = self.hotspot_page()
        if page is not None:
            try:
                page.refresh_sources()
                page.render_state()
            except Exception:
                traceback.print_exc()

    def hotspot_toggle(self):
        if self.hs_busy:
            return
        if self.hs_state.get("running"):
            self.hs_busy = True
            self.hs_message = "Mematikan hotspot..."
            self.hotspot_update()
            try:
                self.hs_client.send(cmd="stop")
            except Exception as exc:
                self.hs_busy = False
                self.hs_message = str(exc)
                self.hotspot_update()
            return
        page = self.hotspot_page()
        if page is None:
            return
        cfg = page.get_config()
        if cfg is None:
            return
        if not os.path.exists(HOTSPOT_HELPER):
            self.info("Helper hotspot belum dipasang.\n\n"
                      "Jalankan dari folder tool:\n"
                      "sudo ./install-hotspot.sh")
            return
        self.hs_busy = True
        self.hs_message = "Menunggu izin administrator..."
        self.say("menyalakan hotspot...")
        self.hotspot_update()
        try:
            self.hs_client.start()
            self.hs_client.send(cmd="start", **cfg)
        except Exception as exc:
            self.hs_busy = False
            self.hs_message = str(exc)
            self.say(str(exc)[:120], RED)
            self.hotspot_update()

    def hotspot_tick(self):
        self.hotspot_drain()
        if not self.hs_client.alive:
            return
        if self.current != "hotspot":
            return
        if time.monotonic() - self.hs_last_poll < 3:
            return
        self.hs_last_poll = time.monotonic()
        try:
            self.hs_client.send(cmd="status")
            if self.hs_state.get("running"):
                self.hs_client.send(cmd="clients")
        except Exception:
            pass

    def hotspot_drain(self):
        while True:
            try:
                msg = self.hs_client.q.get_nowait()
            except queue.Empty:
                break
            if msg.get("event") == "exit":
                self.hs_busy = False
                self.hs_state = {"running": False}
                self.hs_message = "Helper hotspot berhenti."
                self.hotspot_update()
                continue
            if not msg.get("ok", True):
                self.hs_busy = False
                self.hs_message = msg.get("error", "Gagal menjalankan hotspot.")
                self.say(self.hs_message[:120], RED)
                self.hotspot_update()
                continue
            if msg.get("ready"):
                continue
            if "clients" in msg:
                page = self.hotspot_page()
                if page is not None:
                    page.render_clients(msg.get("clients", []))
                continue
            if "blacklist" in msg and "running" not in msg:
                self.hs_cfg["blacklist"] = list(msg.get("blacklist", []))
                save_hotspot_cfg(self.hs_cfg)
                page = self.hotspot_page()
                if page is not None:
                    page.render_blacklist()
                continue
            if "running" in msg:
                self.hs_state = msg
                self.hs_busy = False
                if msg.get("running"):
                    self.hs_message = "Hotspot aktif."
                    self.say("hotspot aktif di %s (%s)" %
                             (msg.get("channel"), msg.get("upstream")), GREEN)
                    try:
                        self.hs_client.send(cmd="clients")
                    except Exception:
                        pass
                else:
                    self.hs_message = "Hotspot dihentikan."
                    self.say("hotspot dihentikan")
                self.hotspot_update()

    def hotspot_refresh(self):
        if not self.hs_client.alive:
            return
        try:
            self.hs_client.send(cmd="status")
            if self.hs_state.get("running"):
                self.hs_client.send(cmd="clients")
        except Exception:
            pass

    def hotspot_kick(self):
        page = self.hotspot_page()
        mac = page.selected_mac() if page else None
        if not mac:
            self.info("Pilih client terlebih dahulu.")
            return
        if not self.ask("Putuskan client %s?" % mac):
            return
        try:
            self.hs_client.send(cmd="kick", mac=mac)
            self.say("client diputuskan", GREEN)
        except Exception as exc:
            self.info(str(exc))

    def hotspot_blacklist_selected(self):
        page = self.hotspot_page()
        mac = page.selected_mac() if page else None
        if not mac:
            self.info("Pilih client terlebih dahulu.")
            return
        if mac not in self.hs_cfg.get("blacklist", []):
            self.hs_cfg.setdefault("blacklist", []).append(mac)
            save_hotspot_cfg(self.hs_cfg)
        page.render_blacklist()
        if self.hs_client.alive:
            try:
                self.hs_client.send(cmd="blacklist", mac=mac, add=True)
                self.say("blacklist diperbarui", GREEN)
            except Exception as exc:
                self.info(str(exc))

    def hotspot_add_blacklist(self):
        page = self.hotspot_page()
        if page is None:
            return
        mac = page.bl_var.get().strip().lower()
        if not re.fullmatch(r"(?:[0-9a-f]{2}:){5}[0-9a-f]{2}", mac):
            self.info("Alamat MAC tidak valid.")
            return
        if mac not in self.hs_cfg.get("blacklist", []):
            self.hs_cfg.setdefault("blacklist", []).append(mac)
            save_hotspot_cfg(self.hs_cfg)
        page.bl_var.set("")
        page.render_blacklist()
        if self.hs_client.alive:
            try:
                self.hs_client.send(cmd="blacklist", mac=mac, add=True)
            except Exception:
                pass

    def hotspot_remove_blacklist(self):
        page = self.hotspot_page()
        if page is None:
            return
        sel = page.bl_list.curselection()
        if not sel:
            return
        mac = page.bl_list.get(sel[0]).lower()
        if mac not in self.hs_cfg.get("blacklist", []):
            return
        self.hs_cfg["blacklist"].remove(mac)
        save_hotspot_cfg(self.hs_cfg)
        page.render_blacklist()
        if self.hs_client.alive:
            try:
                self.hs_client.send(cmd="blacklist", mac=mac, add=False)
            except Exception:
                pass

    def close(self):
        try:
            self.hs_client.close()
        except Exception:
            pass
        self.root.destroy()

    # ---------- scan / konek / portal
    def scan_networks(self):
        page = self.pages["wifi"]
        page.scan_lbl.configure(text="memindai…", fg=MUT)
        self.say("memindai jaringan…")
        def work():
            if not wifi_iface():
                return []
            sh(["nmcli", "device", "wifi", "rescan"], timeout=25)
            time.sleep(2)
            out, _ = sh(["nmcli", "-t", "-f", "SSID,SIGNAL,SECURITY,IN-USE",
                         "device", "wifi", "list"], timeout=25)
            nets = []
            for line in out.splitlines():
                p = split_nmcli(line)
                if len(p) < 4:
                    continue
                ssid, sig, sec, use = p[0], p[1], p[2], ":".join(p[3:])
                if not ssid.strip():
                    continue
                nets.append({"ssid": ssid, "signal": sig, "sec": sec,
                             "inuse": use.strip() == "*"})
            nets.sort(key=lambda n: (not n["inuse"], -int(n["signal"] or 0)))
            unique = {}
            for n in nets:
                key = n["ssid"]
                cur = unique.get(key)
                if cur is None or (n["inuse"], int(n["signal"] or 0)) > (
                        cur["inuse"], int(cur["signal"] or 0)):
                    unique[key] = n
            nets = sorted(unique.values(),
                          key=lambda n: (not n["inuse"], -int(n["signal"] or 0)))
            return nets
        self.bg(work, self.set_networks)

    def set_networks(self, nets):
        page = self.pages["wifi"]
        page.networks = nets
        page.scan_list.delete(0, "end")
        for n in nets:
            mark = "●" if n["inuse"] else " "
            sec = "terbuka" if n["sec"] in ("", "--") else n["sec"]
            page.scan_list.insert(
                "end", "%s %-25s %3s%%  %s" % (mark, n["ssid"][:25], n["signal"], sec))
        page.scan_lbl.configure(text="%d jaringan ditemukan" % len(nets))
        if not nets:
            page.scan_lbl.configure(
                text="0 jaringan — kartu mungkin wedge; coba Reset WiFi", fg=RED)
        else:
            page.scan_lbl.configure(fg=DIM)
        self.say("scan selesai: %d jaringan" % len(nets), GREEN)

    def connect_selected(self):
        page = self.pages["wifi"]
        sel = page.scan_list.curselection()
        if not sel:
            self.say("pilih jaringan dulu (klik dua kali untuk langsung konek)", ORANGE)
            return
        net = page.networks[sel[0]]
        ssid = net["ssid"]
        pwd = ""
        if net["sec"] not in ("", "--"):
            pwd = self.ask_password(ssid)
            if pwd is None:
                return
        self.say("menghubungkan ke %s…" % ssid)

        def work():
            args = ["nmcli", "--ask", "device", "wifi", "connect", ssid]
            data = (pwd + "\n") if pwd else ""
            out, rc = sh_input(args, data, timeout=90)
            if rc != 0 and re.search(r"not authorized|insufficient privilege|polkit",
                                     out, re.I):
                out, rc = sh_input(["pkexec"] + args, data, timeout=150)
            return out, rc

        self.bg(work, lambda r: self.after_connect(ssid, r))

    def after_connect(self, ssid, res):
        out, rc = res
        if rc == 0:
            self.say("terhubung ke %s" % ssid, GREEN)
        else:
            tail = [ln for ln in out.splitlines() if ln.strip()]
            self.say("gagal: %s" % (tail[-1][:130] if tail else "tidak diketahui"), RED)
        self.refresh()
        self.root.after(1200, self.check_portal)

    def check_portal(self):
        def work():
            wifi = next((d for d in dev_list()
                         if d["type"] == "wifi" and d["state"].startswith("connected")), None)
            iface = wifi["dev"] if wifi else ""
            gw = ""
            if iface:
                route, _ = sh(["ip", "route", "show", "dev", iface])
                m = re.search(r"default via (\S+)", route)
                gw = m.group(1) if m else ""
            if not gw:
                route, _ = sh(["ip", "route", "show", "default"])
                m = re.search(r"default via (\S+) dev (\S+)", route)
                if m:
                    gw, iface = m.group(1), m.group(2)
            code, url = "", ""
            if gw:
                cmd = ["curl", "-sS", "-m", "8", "-o", "/dev/null",
                       "-w", "%{http_code} %{redirect_url}"]
                if iface:
                    cmd += ["--interface", iface]
                cmd.append("http://connectivitycheck.gstatic.com/generate_204")
                probe, _ = sh(cmd, timeout=14)
                parts = probe.split(" ", 1)
                code = parts[0].strip()
                if len(parts) > 1:
                    url = parts[1].strip()
            return iface, gw, code, url
        self.bg(work, self.set_portal)

    def set_portal(self, res):
        iface, gw, code, url = res
        page = self.pages.get("wifi")
        if not page:
            return
        self.portal_url = url or ("http://%s/" % gw if gw else "")
        where = ("%s via %s" % (iface, gw)) if iface else "tanpa koneksi"
        cur_conn = ""
        st = getattr(self, "last_state", None)
        if st:
            wd = next((d for d in st["devices"] if d["type"] == "wifi"), None)
            if wd:
                cur_conn = wd.get("conn", "")
        if page.url_entry.get().strip() == "":
            fill = self.load_portal_url(cur_conn) if cur_conn else ""
            if not fill:
                fill = url or (("http://%s/" % gw) if gw else "")
            if fill:
                page.url_entry.insert(0, fill)
        if not gw:
            page.portal_lbl.configure(text="Portal: belum ada koneksi", fg=MUT)
        elif code == "204":
            page.portal_lbl.configure(
                text="%s · internet normal (tanpa portal)" % where, fg=GREEN)
        elif code in ("301", "302", "303", "307", "308") and url:
            page.portal_lbl.configure(
                text="%s · butuh login web: %s" % (where, url), fg=ORANGE)
        elif not code:
            page.portal_lbl.configure(
                text="%s · cek portal gagal (tidak ada balasan); "
                     "coba tombol Buka halaman login" % where, fg=ORANGE)
        else:
            page.portal_lbl.configure(
                text="%s · balasan HTTP %s (kemungkinan portal); "
                     "coba tombol Buka halaman login" % (where, code), fg=ORANGE)

    def open_portal(self):
        page = self.pages.get("wifi")
        url = ""
        if page:
            url = page.url_entry.get().strip()
        if not url:
            url = getattr(self, "portal_url", "") or ""
        if not url:
            st = getattr(self, "last_state", None)
            gw = st.get("default_gw", "") if st else ""
            if gw and gw != "—":
                url = "http://%s/" % gw
        if not url:
            self.say("belum ada gateway (belum terhubung)", ORANGE)
            return
        if not url.startswith("http"):
            url = "http://" + url
        self.save_portal_url(url)
        self.bg(lambda: sh(["xdg-open", url], timeout=20),
                lambda r: self.say("membuka %s" % url, GREEN if r[1] == 0 else RED))

    def portals_path(self):
        return os.path.join(HOME, ".config", "diknom-network", "portal.json")

    def load_portal_url(self, ssid):
        try:
            with open(self.portals_path(), encoding="utf-8") as fh:
                return json.load(fh).get(ssid, "")
        except (OSError, ValueError):
            return ""

    def save_portal_url(self, url):
        page = self.pages.get("wifi")
        ssid = ""
        if page and page.networks:
            st = getattr(self, "last_state", None)
            if st:
                wifi = next((d for d in st["devices"] if d["type"] == "wifi"), None)
                if wifi and wifi.get("conn"):
                    ssid = wifi["conn"]
        if not ssid:
            return
        path = self.portals_path()
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            try:
                with open(path, encoding="utf-8") as fh:
                    data = json.load(fh)
            except (OSError, ValueError):
                data = {}
            data[ssid] = url
            with open(path, "w", encoding="utf-8") as fh:
                json.dump(data, fh, indent=1, sort_keys=True)
        except OSError:
            pass

    def ask_password(self, ssid):
        top = tk.Toplevel(self.root)
        top.title("Kata sandi WiFi")
        top.configure(bg=CARD)
        top.transient(self.root)
        top.resizable(False, False)
