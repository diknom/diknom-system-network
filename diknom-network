                                  bg=CARD, fg=MUT, font=(FONT, SMALL),
                                  anchor="center")
        self.empty_lbl.place(relx=0.5, rely=0.48, anchor="center")

        self.render_blacklist()
        self.render_state()

    def _stat(self, parent, col, label):
        box = tk.Frame(parent, bg=CARD)
        box.grid(row=0, column=col, sticky="w", padx=(0, 16))
        tk.Label(box, text=label, bg=CARD, fg=DIM, font=(FONT, TINY),
                 anchor="w").pack(anchor="w")
        val = tk.Label(box, text="—", bg=CARD, fg=FG,
                       font=(FONT, SMALL, "bold"), anchor="w")
        val.pack(anchor="w", pady=(2, 0))
        return val

    def toggle_password(self):
        self.pass_entry.configure(show="" if self.show_var.get() else "*")

    def get_config(self):
        ssid = self.ssid_var.get().strip()
        if not ssid:
            self.app.info(tr("SSID tidak boleh kosong."))
            return None
        security = self.sec_map.get(self.sec_box.get(), "wpa2")
        password = self.pass_var.get()
        if security != "open" and len(password) < 8:
            self.app.info(tr("Password minimal 8 karakter."))
            return None
        try:
            max_clients = int(self.max_var.get())
        except Exception:
            max_clients = 8
        max_clients = max(1, min(32, max_clients))
        upstream = dict(self.up_options).get(self.up_box.get(), "auto")
        self.cfg.update({"ssid": ssid, "password": password,
                         "security": security, "max_clients": max_clients,
                         "upstream": upstream})
        save_hotspot_cfg(self.cfg)
        return {"ssid": ssid, "password": password, "security": security,
                "max_clients": max_clients, "upstream": upstream,
                "blacklist": list(self.cfg.get("blacklist", []))}

    def selected_mac(self):
        sel = self.tree.selection()
        if not sel:
            return None
        try:
            return str(self.tree.item(sel[0], "values")[0])
        except Exception:
            return None

    def render_clients(self, clients):
        self.tree.delete(*self.tree.get_children())
        for i, c in enumerate(clients):
            secs = int(c.get("connected", 0))
            conn = ("%d mnt" % (secs // 60) if secs >= 60
                    else "%d dtk" % secs)
            state = tr("Blacklist") if c.get("blacklisted") else tr("Terhubung")
            self.tree.insert("", "end", values=(
                c.get("mac", "-"), c.get("ip", "-"), c.get("hostname", "-"),
                c.get("signal", "-"), conn, state),
                tags=("blocked" if c.get("blacklisted")
                      else ("odd" if i % 2 else ""),))
        if clients:
            self.empty_lbl.place_forget()
        else:
            self.empty_lbl.place(relx=0.5, rely=0.48, anchor="center")
        self.update_count(len(clients))

    def update_count(self, n=None):
        if n is None:
            n = len(self.tree.get_children())
        maxn = self.app.hs_state.get("max_clients", self.max_var.get())
        self.count_lbl.configure(
            text=tr("%d client / %s") % (n, maxn))

    def render_blacklist(self):
        self.bl_list.delete(0, "end")
        values = list(self.cfg.get("blacklist", []))
        for mac in values:
            self.bl_list.insert("end", mac)
        if values:
            self.bl_empty.pack_forget()
        else:
            self.bl_empty.pack(fill="x", pady=(4, 0))

    def refresh_sources(self):
        names = [d["dev"] for d in dev_list()
                 if d.get("type") != "wifi"
                 and d["dev"] not in ("lo", "ap0")
                 and not d["dev"].startswith("tailscale")]
        opts = [(tr("Otomatis (LAN/USB)"), "auto")] + [(n, n) for n in names]
        vals = [x[0] for x in opts]
        if vals == list(self.up_box.cget("values")):
            return
        cur = self.up_box.get()
        self.up_options = opts
        self.up_box.configure(values=vals)
        if cur not in vals:
            self.up_box.set(vals[0])

    def render_state(self):
        running = bool(self.app.hs_state.get("running"))
        self.state_lbl.configure(
            text=tr("Aktif") if running else tr("Nonaktif"),
            fg=GREEN if running else MUT)
        st = self.app.hs_state
        if running:
            self.detail_lbl.configure(text=tr(
                "Hotspot berjalan. Client terhubung ke jaringan ini."))
            self.stat_ssid.configure(text=st.get("ssid", "—"))
            self.stat_sec.configure(text=str(st.get("security", "—")).upper())
            self.stat_src.configure(text=st.get("upstream", "—"))
            self.stat_clients.configure(
                text="%s / %s" % (len(self.tree.get_children()),
                                  st.get("max_clients", "—")))
        else:
            if not os.path.exists(HOTSPOT_HELPER):
                self.detail_lbl.configure(
                    text=tr("Helper hotspot belum dipasang. Jalankan "
                            "sudo ./install-hotspot.sh dari folder tool."))
            else:
                self.detail_lbl.configure(
                    text=tr("Uplink LAN/USB. AP Wi-Fi tetap tersedia untuk "
                            "client; uplink Wi-Fi dinonaktifkan sementara."))
            self.stat_ssid.configure(text=self.ssid_var.get() or "—")
            self.stat_sec.configure(text=self.sec_box.get() or "—")
            src = dict(self.up_options).get(self.up_box.get(), "auto")
            self.stat_src.configure(
                text=tr("Otomatis (LAN/USB)") if src == "auto" else src)
            self.stat_clients.configure(text="0 / %s" % self.max_var.get())
        self.msg_lbl.configure(text=tr(self.app.hs_message))
        self.toggle_btn.configure(
            text=tr("Hentikan Hotspot") if running else tr("Mulai Hotspot"),
            state="disabled" if self.app.hs_busy else "normal",
            bg=RED if running else ACCENT,
            activebackground="#b91c1c" if running else "#2563eb")
        self.update_count()

    def apply(self, st):
        pass


