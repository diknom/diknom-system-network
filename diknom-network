                       font=(MONO if mono else FONT, SMALL), anchor="w")
        lbl.pack(side="left", fill="x", expand=True)
        if key:
            self.vals[key] = lbl
        return lbl

    def set_subtitle(self, text):
        if self.sub_lbl is not None:
            self.sub_lbl.configure(text=text)


