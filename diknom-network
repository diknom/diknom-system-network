    def _nav_style(self, key, active=False, hover=False):
        bg = "#111b27" if active else ("#101821" if hover else SIDEBAR)
        fg = FG if active else MUT
        self.nav[key].configure(bg=bg)
        for child in self.nav[key].winfo_children():
            child.configure(bg=bg)
            for sub in child.winfo_children():
                if isinstance(sub, tk.Label):
                    sub.configure(bg=bg)
        self.nav_bars[key].configure(bg=ACCENT if active else bg)
        for lab in self.nav_labels[key]:
            lab.configure(fg=fg)

    def hover(self, key, on):
        if key == self.current:
            return
        self._nav_style(key, False, on)

    def show(self, key):
        if self.current == key:
            return
        if self.current:
            self.pages[self.current].pack_forget()
            self._nav_style(self.current, False, False)
        self.current = key
        self.pages[key].pack(fill="both", expand=True)
        self._nav_style(key, True, False)
        try:
            self.canvas.yview_moveto(0)
            self.canvas.update_idletasks()
            self.canvas.itemconfigure(self.host_window,
                                      width=self.canvas.winfo_width())
        except Exception:
            pass
        meta = PAGE_META.get(key, ("", ""))
        self.page_title.configure(text=tr(meta[0]))
        self.page_sub.configure(text=tr(meta[1]))
        if key == "wifi":
            self.last_log = 0
            self.bg(lambda: recent_log(), self.set_log)
            self.check_portal()
            self.scan_networks()
        if key == "hotspot":
            self.pages["hotspot"].render_state()
            self.hotspot_refresh()
        self.apply_last()

